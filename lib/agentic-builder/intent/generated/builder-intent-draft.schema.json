{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/agentic-builder/generate-artifacts.ts from lib/agentic-builder/intent/spec/*. Do not edit generated output manually.",
  "$id": "https://keeperhub.local/schemas/agentic-builder/builder-intent-draft.schema.json",
  "title": "BuilderIntentDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "prompt",
    "clauses",
    "unresolved",
    "assumptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agentic-builder.intent.v1"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/intentClause"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedRequirement"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/builderAssumption"
      }
    }
  },
  "$defs": {
    "requirementStatus": {
      "type": "string",
      "enum": [
        "satisfied",
        "missing",
        "ambiguous",
        "conflicting",
        "unsupported"
      ]
    },
    "unresolvedRequirementStatus": {
      "type": "string",
      "enum": [
        "missing",
        "ambiguous",
        "conflicting",
        "unsupported"
      ]
    },
    "requirementKind": {
      "type": "string",
      "enum": [
        "trigger",
        "schedule",
        "temporal_window",
        "read_data",
        "state",
        "comparison",
        "condition",
        "branch",
        "notification",
        "write_action",
        "custom_capability"
      ]
    },
    "intentConnector": {
      "type": "string",
      "enum": [
        "and",
        "or",
        "then",
        "via",
        "with",
        "about",
        "when"
      ]
    },
    "capabilityIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/requirementKind"
        },
        "status": {
          "$ref": "#/$defs/requirementStatus"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sourceText": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "object",
          "additionalProperties": true
        },
        "capabilityIntent": {
          "$ref": "#/$defs/capabilityIntent"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "blocksMaterialization": {
          "type": "boolean"
        }
      }
    },
    "intentClause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceText",
        "requirements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceText": {
          "type": "string",
          "minLength": 1
        },
        "connector": {
          "$ref": "#/$defs/intentConnector"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/intentRequirement"
          }
        }
      }
    },
    "unresolvedRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "status",
        "question",
        "blocksMaterialization"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/unresolvedRequirementStatus"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "blocksMaterialization": {
          "type": "boolean"
        }
      }
    },
    "builderAssumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
